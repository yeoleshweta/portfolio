# Google Analytics 4 — Measurement ID from Admin → Data streams
# Leave empty to disable analytics entirely (safe default).
NEXT_PUBLIC_GA_ID=

# Optional: log every custom event to the browser console as [analytics]
# (works even when NEXT_PUBLIC_GA_ID is empty)
# NEXT_PUBLIC_GA_DEBUG=true

# First-party analytics (independent from GA4). Set true after applying the migration.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Supabase project URL and publishable/anon key (safe for browser auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: NEVER prefix the service role key with NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated admin emails. No public registration is offered by the app.
ADMIN_EMAILS=
# Canonical origin, without a trailing path
SITE_URL=http://localhost:3000
# Random server-only secret for the scheduled retention endpoint
CRON_SECRET=

# Google SMTP alerts (server-only). Use a Google app password, not your account password.
SMTP_USER=
SMTP_PASSWORD=
# GA4 reporting: numeric property ID and a JSON service-account credential (server-only).
# Enable Analytics Data API and grant the service-account email Viewer access to this property.
GA_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Explicit production-only switch. Previews, tests and development never send alerts.
SMTP_ALERT_DELIVERY_ENABLED=false
